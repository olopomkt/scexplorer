# SC Explorer — nomes das variáveis (os valores ficam só no .env local e no painel da Netlify).
# Netlify: Site configuration → Environment variables → mesmos nomes.

# Supabase (Project Settings → API). URL e publishable vão para o navegador; a secret, só para o coletor.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Só para aplicar migrations deste computador (npm run migrar). Não precisa na Netlify.
DATABASE_URL=

# Fontes de dados (passo a passo em docs/CHAVES.md)
TOMTOM_KEY=
WEATHERAPI_KEY=
OPENWEATHER_KEY=
